{% extends 'base.html.twig' %}

{% block title %} Utilisateurs{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1> Utilisateurs ({{ users|length }})</h1>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">⬅ Retour</a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Rôle</th>
                <th>Parties</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>
                    {{ user.username }}
                    {% if user == app.user %}
                        <span class="badge bg-info">Vous</span>
                    {% endif %}
                </td>
                <td>
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="badge bg-danger">🛡️ Admin</span>
                    {% else %}
                        <span class="badge bg-secondary">👤 User</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('admin_user_show', {id: user.id}) }}">
                        {{ user.games|length }} parties
                    </a>
                </td>
                <td>
                    <a href="{{ path('admin_user_show', {id: user.id}) }}" class="btn btn-sm btn-info">👁️</a>

                    {% if user != app.user %}
                        <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" class="d-inline"
                              onsubmit="return confirm('Supprimer {{ user.username }} ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ user.id) }}">
                            <button class="btn btn-sm btn-danger">🗑️</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}