{% extends 'base.html.twig' %}

{% block title %}Modifier la partie{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="col-md-6 mx-auto">
        <a href="{{ path('admin_user_show', {id: game.player.id}) }}" 
           class="btn btn-secondary mb-3">⬅ Retour</a>

        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h3>Modifier la partie</h3>
            </div>
            <div class="card-body">
                <p>Joueur : <strong>{{ game.player.username }}</strong></p>

                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_row(form.difficulty) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.guessNumber) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.winOrLose) }}
                    </div>
                    <button type="submit" class="btn btn-success">Sauvegarder</button>
                    <a href="{{ path('admin_user_show', {id: game.player.id}) }}" 
                       class="btn btn-secondary">Annuler</a>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}