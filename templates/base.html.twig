<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Le Maître des Mots{% endblock %}</title>
    
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% endblock %}
</head>
<body>
    <header>
        <div class="header-content">
            <a href="{{ path('hangman_home') }}" class="logo">Word Master</a>
            {% block menu %}
                {% include 'partials/navigation.html.twig' %}
            {% endblock %}
        </div>
    </header>
    
    <main>
        {% block body %}{% endblock %}
    </main>
    
    <footer>
        {% block footer %}
            <p>&copy; 2025 - Word Master | Créé par Mathias Lin</p>
        {% endblock %}
    </footer>
    
    {% block javascripts %}{% endblock %}
</body>
</html>