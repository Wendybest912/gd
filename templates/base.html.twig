<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Le Maître des Mots{% endblock %}</title>
    
    {% block stylesheets %}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            color: #fff;
        }
        
        header {
            background: rgba(0, 0, 0, 0.3);
            padding: 15px 0;
        }
        
        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            text-decoration: none;
            color: #fff;
        }
        
        .main-nav ul {
            list-style: none;
            display: flex;
            gap: 20px;
        }
        
        .main-nav a {
            color: #fff;
            text-decoration: none;
            padding: 8px 15px;
            border-radius: 5px;
            transition: background 0.3s;
        }
        
        .main-nav a:hover {
            background: rgba(255, 255, 255, 0.2);
        }
        
        main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        
        h1 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 2.5rem;
        }
        
        h2 {
            margin-bottom: 20px;
        }
        
        .btn {
            display: inline-block;
            padding: 12px 25px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: transform 0.3s, box-shadow 0.3s;
            margin: 5px;
            cursor: pointer;
            border: none;
        }
        
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }
        
        .btn-primary {
            background: #4CAF50;
            color: #fff;
        }
        
        .btn-secondary {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            border: 2px solid #fff;
        }
        
        /* Difficulty Cards */
        .difficulties-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }
        
        .difficulty-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            transition: transform 0.3s;
        }
        
        .difficulty-card:hover {
            transform: translateY(-10px);
        }
        
        .difficulty-card.facile { border: 3px solid #4CAF50; }
        .difficulty-card.moyen { border: 3px solid #FF9800; }
        .difficulty-card.difficile { border: 3px solid #f44336; }
        .difficulty-card.impossible { border: 3px solid #9C27B0; }
        .difficulty-card.divin { border: 3px solid #FFD700; }
        
        .difficulty-icon {
            font-size: 3rem;
            display: block;
            margin-bottom: 15px;
        }
        
        /* Game Display */
        .game-container {
            text-align: center;
        }
        
        .game-info {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: inline-block;
        }
        
        .hangman-drawing pre {
            font-size: 1.2rem;
            line-height: 1.3;
            font-family: monospace;
        }
        
        .word-display {
            margin: 30px 0;
        }
        
        .letter {
            display: inline-block;
            width: 40px;
            height: 50px;
            line-height: 50px;
            margin: 5px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 5px;
            font-size: 24px;
            font-weight: bold;
        }
        
        .letter.found {
            background: #4CAF50;
        }
        
        .keyboard .keys {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .key {
            width: 45px;
            height: 45px;
            border: none;
            border-radius: 8px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            background: #fff;
            color: #333;
        }
        
        .key.correct { background: #4CAF50; color: #fff; }
        .key.incorrect { background: #f44336; color: #fff; }
        .key:disabled { opacity: 0.5; cursor: not-allowed; }
        
        /* Results */
        .result-container {
            text-align: center;
            padding: 50px;
            border-radius: 20px;
        }
        
        .big-emoji {
            font-size: 5rem;
            margin: 20px 0;
        }
        
        .victory { background: rgba(76, 175, 80, 0.2); }
        .defeat { background: rgba(244, 67, 54, 0.2); }
        
        /* Rules */
        .rules-section {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }
        
        .rules-section ul {
            margin-left: 20px;
            margin-top: 10px;
        }
        
        .rules-section li {
            margin-bottom: 8px;
        }
        
        /* Footer */
        footer {
            text-align: center;
            padding: 20px;
            background: rgba(0, 0, 0, 0.3);
            margin-top: 40px;
        }
        
        .buttons {
            margin-top: 30px;
            text-align: center;
        }
        
        /* Home */
        .home-container {
            text-align: center;
            padding: 50px 0;
        }
        
        .home-container .description {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto 30px;
            line-height: 1.6;
        }
        
        /* Stats */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }
        
        .stat-card {
            background: rgba(255, 255, 255, 0.1);
            padding: 25px;
            border-radius: 15px;
            text-align: center;
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            display: block;
        }
        
        /* Badge */
        .badge {
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 0.9rem;
            display: inline-block;
        }
        
        .badge.facile { background: #4CAF50; }
        .badge.moyen { background: #FF9800; }
        .badge.difficile { background: #f44336; }
        .badge.impossible { background: #9C27B0; }
        .badge.divin { background: linear-gradient(45deg, #FFD700, #FFA500); }
    </style>
    {% endblock %}
</head>
<body>
    <header>
        <div class="header-content">
            <a href="{{ path('hangman_home') }}" class="logo"> Le Maître des Mots</a>
            {% block menu %}
                {% include 'partials/navigation.html.twig' %}
            {% endblock %}
        </div>
    </header>
    
    <main>
        {% block body %}{% endblock %}
    </main>
    
    <footer>
        {% block footer %}
            <p>&copy; 2025 - Le Maître des Mots | Créé par Mathias Lin</p>
        {% endblock %}
    </footer>
    
    {% block javascripts %}{% endblock %}
</body>
</html>