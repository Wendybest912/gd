{% extends "base.html.twig" %}

{% block title %}Victoire ! - Le Maître des Mots{% endblock %}

{% block body %}
    <div class="result-container victory">
        <h1> Bravo </h1>
        
        <p class="big-emoji">🏆</p>
        
        <p class="result-word">Le mot était : <strong>{{ word }}</strong></p>
        
