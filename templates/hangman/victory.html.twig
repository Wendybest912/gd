        <div class="buttons">
            <a href="{{ path('hangman_difficulties') }}" class="btn btn-primary"> Rejouer</a>
            <a href="{{ path('hangman_home') }}" class="btn btn-secondary"> Accueil</a>
        </div>
    </div>
{% endblock %}